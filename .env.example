# ============================================================
# 短视频脚本 Agent —— 环境变量示例
# ------------------------------------------------------------
# 用法：复制本文件为 .env 并填写真实值。
#   * 如果只想跑通流程（离线、无网络），无需任何配置：
#       node src/cli.js run --input examples/inputs/01_normal.json --llm mock
#   * 如需真实模型决策，配置下面的 OpenAI 兼容接口，并用 --llm live。
# 注意：.env 已在 .gitignore 中，请勿把真实密钥提交到仓库。
# ============================================================

# —— 真实模型（OpenAI 兼容 /chat/completions 接口）——
# 本项目默认指向 CSU Chat 网关（provider "csu"），也可换成任意兼容网关。
OPENAI_BASE_URL=https://api.chat.csu.edu.cn/v1
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=DeepSeek
OPENAI_TIMEOUT_MS=120000

# —— Agent 运行上限（达到上限返回明确未完成状态）——
AGENT_MAX_STEPS=16
AGENT_MAX_TOOL_CALLS=16
